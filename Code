void pollSupabase() {
  if (WiFi.status() != WL_CONNECTED) return;
  WiFiClientSecure client;
  client.setInsecure(); // For a quick prototype only; production should validate TLS certificates.
  HTTPClient http;
  String url = String(SUPABASE_URL) + "/rest/v1/" + NOTICE_TABLE + "?select=id,title,message,created_at&order=created_at.desc&limit=1";
  if (!http.begin(client, url)) { Serial.println("Supabase HTTP begin failed"); return; }
  http.addHeader("apikey", SUPABASE_ANON_KEY);
  http.addHeader("Authorization", String("Bearer ") + SUPABASE_ANON_KEY);
  int code = http.GET();
  if (code == HTTP_CODE_OK) {
    String payload = http.getString();
    JsonDocument doc;
    DeserializationError err = deserializeJson(doc, payload);
    if (!err && doc.is<JsonArray>() && doc.size() > 0) {
      JsonObject n = doc[0];
      String id = n["id"].isNull() ? "" : n["id"].as<String>();
      if (id != lastNoticeId) {
        lastNoticeId = id;
        Serial.println("\n========== SRM AP NOTICE ==========");
        Serial.println("Title: " + String(n["title"] | ""));
        Serial.println("Message: " + String(n["message"] | ""));
        Serial.println("Created: " + String(n["created_at"] | ""));
        Serial.println("===================================\n");
      }
    } else if (err) {
      Serial.print("JSON parse error: "); Serial.println(err.c_str());
    }
  } else {
    Serial.printf("Supabase poll HTTP status: %d\n", code);
    if (code > 0) Serial.println(http.getString());
  }
  http.end();
}

// Reads DHT11 + MQ-2, keeps the latest values for the web page (/sensor) and
// uploads them to Supabase table board_status (used by live.html on Netlify).
void readAndPublishSensors() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  int gasRaw = analogRead(MQ2_PIN);
  if (isnan(t) || isnan(h)) { Serial.println("DHT11 read failed; skipping update."); return; }
  int gasPct = constrain((gasRaw * 100L) / 4095L, 0, 100); // relative ADC %, not ppm
  lastTemp = t; lastHum = h; lastGasRaw = gasRaw; lastGasPct = gasPct;
  sensorValid = true; lastSensorMs = millis();
  Serial.printf("Sensors: %.1f C, %.1f%% humidity, MQ2 raw=%d\n", t, h, gasRaw);
  if (WiFi.status() != WL_CONNECTED) return;
  WiFiClientSecure client;
  client.setInsecure(); // prototype only
  HTTPClient http;
  String url = String(SUPABASE_URL) + "/rest/v1/board_status?on_conflict=id";
  if (!http.begin(client, url)) return;
  http.addHeader("apikey", SUPABASE_ANON_KEY);
  http.addHeader("Authorization", String("Bearer ") + SUPABASE_ANON_KEY);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("Prefer", "resolution=merge-duplicates,return=minimal");
  String payload = "{\"id\":1,\"temp_c\":" + String(t, 1) + ",\"humidity\":" + String(h, 1) +
    ",\"gas_raw\":" + String(gasRaw) + ",\"gas_percent\":" + String(gasPct) + ",\"online\":true}";
  int code = http.POST(payload);
  if (code < 200 || code >= 300) {
    Serial.printf("Telemetry upload failed: HTTP %d\n", code);
    if (code > 0) Serial.println(http.getString());
  }
  http.end();
}

void setup() {
  dht.begin();
  analogReadResolution(12);
  Serial.begin(115200);
  delay(500);
  Serial.println("\nSRM AP Smart Notice Board booting...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to Wi-Fi");
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 25000) {
    delay(500); Serial.print('.');
  }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("Connected. ESP32 local IP: http://"); Serial.println(WiFi.localIP());
  } else {
    Serial.println("Wi-Fi connection failed. Check SSID/password and restart.");
  }
  // Main page: admin login
  server.on("/", HTTP_GET, handleRoot);
  server.on("/login", HTTP_GET, handleRoot);

  // Admin dashboard (login required in the page's JavaScript)
  server.on("/admin", HTTP_GET, handleAdmin);

  // Public/user display: support several easy-to-remember URL paths
  server.on("/sensor", HTTP_GET, [](){
    String j = "{\"valid\":" + String(sensorValid ? "true" : "false") +
      ",\"temp\":" + String(lastTemp, 1) + ",\"hum\":" + String(lastHum, 1) +
      ",\"gas\":" + String(lastGasRaw) + ",\"pct\":" + String(lastGasPct) +
      ",\"age\":" + String(sensorValid ? (millis() - lastSensorMs) : 0UL) + "}";
    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "application/json", j);
  });
  server.on("/notices", HTTP_GET, handleNotices);
  server.on("/user", HTTP_GET, handleNotices);
  server.on("/display", HTTP_GET, handleNotices);
  server.on("/public", HTTP_GET, handleNotices);

  server.onNotFound([](){
    String message = "Page not found on the ESP32 web server.\\n\\n";
    message += "Open the ESP32 IP address shown in Serial Monitor.\\n";
    message += "Admin login: / or /login\\n";
    message += "Admin dashboard: /admin\\n";
    message += "User display: /notices, /user, /display, or /public\\n";
    server.send(404, "text/plain; charset=utf-8", message);
  });
  server.begin();
  Serial.println("Web server started on port 80.");
  Serial.println("Open the local IP from a device on the same Wi-Fi.");
}

void loop() {
  server.handleClient();
  if (millis() - lastSensorRead >= SENSOR_INTERVAL_MS) {
    lastSensorRead = millis();
    readAndPublishSensors();
  }
  if (millis() - lastPoll >= POLL_INTERVAL_MS) {
    lastPoll = millis();
    pollSupabase();
  }
}
