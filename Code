<script>
// Intro screen: every word floats in one after another; the screen then stays long enough to read.
// Tune the timing here (milliseconds):
(function(){
  const WORD_STEP_MS=140;        // gap between one word and the next
  const LOGO_MS=700;             // time the logo gets before the first word
  const WORD_ANIM_MS=800;        // length of each word's float animation
  const READ_HOLD_MS=2000;       // minimum extra time to read after the last word
  const PER_WORD_HOLD_MS=0;      // extra reading time added for every word on the screen
  const ONCE_PER_SESSION=true;   // true = full intro only on first visit per browser session
  const splash=document.getElementById('introSplash');
  if(!splash)return;
  let seen=false;
  try{seen=ONCE_PER_SESSION&&sessionStorage.getItem('introSeen')==='1';}catch(e){}
  try{if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)seen=true;}catch(e){}
  if(seen){splash.style.display='none';return;}
  const logo=document.querySelector('header .logo');
  const slot=document.getElementById('introLogoSlot');
  if(logo&&slot){const clone=logo.cloneNode(true);clone.removeAttribute('style');slot.appendChild(clone);slot.classList.add('reveal-line');slot.style.animationDelay='0.1s';}
  const intro=splash.querySelector('.intro-inner');
  let n=0;
  function wrap(node){
    if(node.nodeType===3){
      const frag=document.createDocumentFragment();
      node.textContent.split(/(\s+)/).forEach(function(p){
        if(!p)return;
        if(/^\s+$/.test(p)){frag.appendChild(document.createTextNode(' '));return;}
        const sp=document.createElement('span');sp.className='w';sp.textContent=p;
        sp.style.animationDelay=(LOGO_MS+n*WORD_STEP_MS)+'ms';n++;frag.appendChild(sp);
      });
      node.parentNode.replaceChild(frag,node);
    }else if(node.nodeType===1&&node.id!=='introLogoSlot'){
      Array.from(node.childNodes).forEach(wrap);
    }
  }
  if(intro)wrap(intro);
  const totalMs=LOGO_MS+n*WORD_STEP_MS+WORD_ANIM_MS+READ_HOLD_MS+n*PER_WORD_HOLD_MS;
  let timer=null;
  function finish(){
    if(timer){window.clearTimeout(timer);timer=null;}
    splash.classList.add('done');
    try{sessionStorage.setItem('introSeen','1');}catch(e){}
  }
  const skip=document.createElement('button');
  skip.type='button';skip.className='skip-intro';skip.textContent='Skip intro';skip.onclick=finish;
  splash.appendChild(skip);
  timer=window.setTimeout(finish,totalMs);
})();

